{
  "name": "empresti",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-prototype.cjs && next dev",
    "build": "node scripts/sync-prototype.cjs && prisma generate && next build",
    "start": "next start",
    "test": "node --test tests/catalogo.test.cjs",
